{
  "name": "the-wire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "description": "The Wire - Nakuru Press Club publication & newsroom panel.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node scripts/role-consistency.mjs && node scripts/rpc-contract-check.mjs && node tests/roles.mjs",
    "test:roles": "node tests/roles.mjs",
    "test:rpc": "node scripts/rpc-contract-check.mjs",
    "test:consistency": "node scripts/role-consistency.mjs",
    "lint:sql": "node scripts/role-consistency.mjs",
    "test:credits": "node scripts/credits-check.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "lint:encoding": "node scripts/encoding-check.mjs",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
