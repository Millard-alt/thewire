# =============================================================================
#  THE WIRE â€” ENVIRONMENT CONFIGURATION
# =============================================================================
#  Copy this file to `.env` and fill in real values.
#  Vite loads `.env` automatically and exposes only variables prefixed with
#  `VITE_` to the browser bundle via `import.meta.env`.
#
#  !! SECURITY NOTE !!
#  Only the *anon / publishable* key may ever live in this file. It is embedded
#  in the client bundle by design and is protected by Supabase Row Level Security
#  (see `supabase/schema.sql`). NEVER put the `service_role` key, database
#  passwords, or any other secret in a `VITE_` variable â€” anything prefixed with
#  VITE_ is public. Server-only secrets belong in a real server environment
#  (Vercel/Netlify "Server" environment variables) used by an Edge Function.
# =============================================================================

# --- Supabase project ---------------------------------------------------------
# Project URL: Supabase Dashboard -> Project Settings -> Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon / publishable key (safe for the browser, gated by RLS)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY

# Set to `true` to run against localStorage only, with zero network calls.
# Handy for UI work / demos before a Supabase project exists.
VITE_DEMO_MODE=false

# --- Publication identity -----------------------------------------------------
VITE_SITE_NAME=The Wire
VITE_SITE_TAGLINE=MJLA Press Club â€¢ Independent Verified Dispatches
VITE_PUBLICATION_LOCATION=Nakuru, Kenya

# --- Admin access -------------------------------------------------------------
# Comma-separated list of USERNAMES allowed into the Owner Control Center.
# Every authenticated user can sign in, but only these get the "Admin Panel"
# link and the privileged workspace. Usernames are the staff-facing identity.
VITE_ADMIN_USERNAMES=chief.owner

# Legacy: comma-separated e-mail addresses. Still honoured, so any account
# created before usernames were introduced keeps its access.
VITE_ADMIN_EMAILS=melvinjonespressclub@gmail.com

# Optional: comma-separated Supabase Auth UUIDs (takes priority over both)
VITE_ADMIN_USER_IDS=

# Domain used to build the hidden "shadow" address behind each username, e.g.
# `chief.owner` -> `chief.owner@users.thewire.press`. Staff never see or type
# this; it exists only because Supabase's auth API requires an e-mail.
# Change it before going live if you like, but never change it afterwards â€”
# doing so orphans every existing username account.
VITE_AUTH_EMAIL_DOMAIN=users.thewire.press

# --- Feature flags ------------------------------------------------------------
VITE_ENABLE_PUSH_BROADCASTS=true
VITE_ENABLE_FORCED_NOTIFICATION_LOCKOUT=false

# --- Web Push (VAPID) -----------------------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
#
# PUBLIC key  -> goes HERE, in this file, as VITE_VAPID_PUBLIC_KEY.
#                 It is not a secret; the browser needs it to subscribe.
#
# PRIVATE key -> NEVER here, and never anywhere the browser can read.
#                 Do not prefix it with VITE_, do not add it to this file, and
#                 do not commit it. It belongs only in the environment of the
#                 server or Edge Function that actually SENDS the push, e.g.
#                   Vercel/Netlify -> Project Settings -> Environment Variables
#                   Supabase       -> Edge Functions -> Secrets
#                 Anyone holding it can impersonate your sender and push
#                 notifications to every subscriber.
#
# Leaving the public key blank is safe: the app falls back to in-app
# notifications only, which reach a reader while the tab is open but NOT while
# it is closed.
VITE_VAPID_PUBLIC_KEY=BPbxG5nYUJHgIYCHpqr9B0Ae30748DX2WXmbNG3x3RJOckj0_Eekqjs-9lZglN_ZTjl9Z4ZYDUQ3dcroXte6EW8

# Absolute https:// URL a reader lands on when they tap a notification.
# Empty means "this origin".
VITE_NOTIFICATION_TARGET_URL=

# --- Push SENDER secrets (server only — never prefix with VITE_) ---------------
# These belong in Vercel -> Project Settings -> Environment Variables, NOT in
# this file, and NOT in any VITE_ variable. They are read by api/send-push.js
# (also mounted at /api/broadcast).
#
# VAPID_PRIVATE_KEY
#     The private half of the pair generated above. api/send-push.js calls
#     webpush.setVapidDetails() with it, which is what makes a push a genuine
#     background delivery to a device with the app closed.
#
# PUSH_SEND_TOKEN
#     Optional shared secret for the cron and the Supabase database webhook:
#         curl -H "Authorization: Bearer $PUSH_SEND_TOKEN" .../api/send-push
#     The Owner Panel does NOT need it. The panel authenticates with the Owner's
#     own x-wire-token session header, which the function verifies resolves to the
#     Owner via wire_session_diagnostic(). If this is unset, the panel still works
#     as long as you are signed in as the Owner; only the cron needs it.
#
# VAPID_SUBJECT
#     Contact address the push services use to reach you about a failed send.
#     Defaults to mailto:melvinjonespressclub@gmail.com if unset.
#
# SUPABASE_SERVICE_ROLE_KEY
#     Recommended for the sender so it can read push_subscriptions.p256dh/auth,
#     which are deliberately not readable by anon. Falls back to the anon key if
#     unset, which will return zero usable subscriptions.
