node_modules/
dist/
dist-ssr/
*.local

# Environment files — never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# One-off local database exports - not source
backup/

# Throwaway diagnostic scripts. Kept out of the repo so a debugging session
# can never leave clutter behind. Real tests live in tests/ and are tracked;
# run them with `npm test`.
diag*.mjs
check-*.mjs
verify-*.mjs
dbg*.mjs

# Vercel import sheet - contains real credentials, never commit
vercel-env.txt

# Demo-mode env used by `npm test` (--mode demo). Committing it is fine now
# that it holds no real credentials, but keep it out if you ever paste real
# keys into it. .env stays untracked.
.env.demo
# Local scratch files from test/build/dev-server runs
tmp-*.log
tmp-*.err
tmp-*.mjs

# Ad-hoc local scratch/probe output
tmp-*.txt
tmp-*.cjs

# Screenshots written by the layout-check probes. Binary, so the encoding
# linter skips them, but they still must not reach the repo.
tmp-*.png
tmp-*.jpg
